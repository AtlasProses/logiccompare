an><span>))</span></span>\n        \n        \n          \n          \t\t\t\t<span>return</span>;;\n        \n        \n          \n          \t\t\t<span>esac</span>\n        \n        \n          \n          \t\t<span>done</span>;;\n        \n        \n          \n          \t<span>*</span>)\n        \n        \n          \n          \t\t_COL=<span><span>$((</span>_COL <span>+</span> <span>${<span>#</span>_s}</span><span>))</span></span>;;\n        \n        \n          \n          \t<span>esac</span>\n        \n        \n          \n          }\n        \n        \n          \n          \n\n        \n        \n          \n          <span><span>#</span> Validate CONSUMED as RFC 8259 number: [-](0|[1-9]d*)[.d+][eE[+-]d+]</span>\n        \n        \n          \n          <span>_numck</span> () {\n        \n        \n          \n          \t<span>local</span> _n=<span><span>\"</span><span>$CONSUMED</span><span>\"</span></span>\n        \n        \n          \n          \t<span>case</span> <span><span>\"</span><span>$_n</span><span>\"</span></span> <span>in</span> <span><span>'</span>-<span>'</span></span><span>*</span>) _n=<span><span>\"</span><span>${_n<span>#</span>-}</span><span>\"</span></span>;; <span>esac</span>\n        \n        \n          \n          \t<span>case</span> <span><span>\"</span><span>$_n</span><span>\"</span></span> <span>in</span>\n        \n        \n          \n          \t\t<span><span>'</span><span>'</span></span>) _error NUMBER;;\n        \n        \n          \n          \t\t<span><span>'</span>0<span>'</span></span>[0-9]<span>*</span>) _error NUMBER;;\n        \n        \n          \n          \t\t<span><span>'</span>0<span>'</span></span><span>*</span>) _n=<span><span>\"</span><span>${_n<span>#</span>0}</span><span>\"</span></span>;;\n        \n        \n          \n          \t\t[1-9]<span>*</span>) _n=<span><span>\"</span><span>${_n<span>#</span>[1-9]}</span><span>\"</span></span><span>;</span> _n=<span><span>\"</span><span>${_n<span>