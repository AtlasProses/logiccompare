                  <p>\n                    </p><dt>Context (tokens)</dt>\n                    <dd>1,048,576</dd>\n                  <p></p>\n                  \n                    <p>\n                      </p><dt>Vocabulary</dt>\n                      <dd>131,072</dd>\n                    <p></p>\n                  \n                  <p>\n                    </p><dt>License</dt>\n                    <dd>OpenMDW 1.1</dd>\n                  <p></p>\n                  <p>\n                    </p><dt>Date</dt>\n                    <dd>2026-08-11</dd>\n                  <p></p>\n                  <p>\n                    </p><dt>Decoder type</dt>\n                    <dd>Hybrid MoE</dd>\n                  <p></p>\n                  <p>\n                    </p><dt>Attention</dt>\n                    <dd>Mostly Mamba-2 with six GQA layers</dd>\n                  <p></p>\n                  <p>\n                    </p><dt>Layer mix</dt>\n                    <dd>6 GQA + 23 Mamba-2 + 23 MoE; GQA + MoE MTP predictor</dd>\n                  <p></p>\n                  <p>\n                    </p><dt>\n                      KV cache / token (bf16)\n                      \n                        info\n                      \n                    </dt>\n                    <dd>\n                      6 KiB · Very low\n                    </dd>\n                  <p></p>\n                  <p>\n                    </p><dt>Key detail</dt>\n                    <dd>Adds a one-step GQA-plus-MoE MTP predictor to the 52-layer Nemotron 3 Nano backbone.</dd>\n                  <p></p>\n                  \n                  \n                  \n                </dl>\n                <div>\n                      <p>Related concepts</p>\n                      <p>RMSNorm\n                        \n                        \n                          \n                          \n                          \n                            \n                            \n                      