---
import Authors from "@/components/Authors.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const authors = await getSinglePage("authors");
const sortedAuthors = sortByDate(authors);

// Calculate categories for the filter pills
const allCategories = authors.flatMap((author) => author.data.categories || []);
const categoryCounts = allCategories.reduce((acc, cat) => {
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const uniqueCategories = Object.keys(categoryCounts).sort();
---

<Base title="Authors | LogicCompare" description="Meet our elite team of systems architects, technical writers, and industry analysts.">
  <section class="section py-12">
    <div class="container text-center">
      <!-- Title & Underline -->
      <div class="text-center mb-8">
        <h1 class="h2 font-bold text-dark mb-1">Authors</h1>
        <div class="w-12 h-1 bg-primary mx-auto rounded-full"></div>
      </div>
      
      <!-- Filter Pills -->
      <div class="mb-12 flex flex-wrap justify-center gap-2" id="author-filters">
        <button
          class="author-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition duration-300 border bg-primary text-white border-primary shadow-sm"
          data-filter="all"
        >
          All ({authors.length})
        </button>
        {
          uniqueCategories.map((cat) => (
            <button
              class="author-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition duration-300 border bg-white text-dark border-border hover:border-primary hover:text-primary"
              data-filter={cat}
            >
              {cat} ({categoryCounts[cat]})
            </button>
          ))
        }
      </div>

      <!-- 3-Column Authors Grid -->
      <Authors authors={sortedAuthors} />
    </div>
  </section>
</Base>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const filterButtons = document.querySelectorAll("#author-filters .author-filter-btn");
    const authorCards = document.querySelectorAll(".author-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filterValue = btn.getAttribute("data-filter");

        // Toggle active button style
        filterButtons.forEach((b) => {
          b.classList.remove("bg-primary", "text-white", "border-primary", "shadow-sm");
          b.classList.add("bg-white", "text-dark", "border-border");
        });
        btn.classList.add("bg-primary", "text-white", "border-primary", "shadow-sm");
        btn.classList.remove("bg-white", "text-dark", "border-border");

        // Show / Hide cards
        authorCards.forEach((card) => {
          const cardCategories = JSON.parse(card.getAttribute("data-categories") || "[]");
          if (filterValue === "all" || cardCategories.includes(filterValue)) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  });
</script>

