---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from "astro:content";
import { FiCheckCircle, FiCpu, FiGlobe, FiShield } from "react-icons/fi";

const entry = (await getEntry("about", "-index")) as CollectionEntry<"about">;
const { Content } = await render(entry);
const { title, meta_title, image, what_i_do } = entry.data;

const pillarIcons = [
  FiShield,
  FiCpu,
  FiGlobe
];
---

<Base title={title} meta_title={meta_title} image={image}>
  <section class="section py-14">
    <div class="container">
      <div class="row md:gx-8 gy-8 items-start">
        <!-- Left Column: Visual with Glassmorphism Card -->
        <div class="col-12 md:col-5 lg:col-4">
          <div class="relative group">
            {
              image && (
                <div class="overflow-hidden rounded-2xl shadow-md border border-border/80 bg-light">
                  <img
                    src={image}
                    width="400"
                    height="500"
                    alt="LogicCompare Intelligence Network"
                    class="w-full h-auto object-cover group-hover:scale-105 transition duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )
            }
            <!-- Floating Glassmorphism Badge -->
            <div class="absolute -bottom-4 -right-2 sm:right-4 bg-white/95 backdrop-blur-md border border-border shadow-lg rounded-xl p-3.5 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-lg">
                ✓
              </div>
              <div>
                <p class="text-[11px] uppercase tracking-wider text-text font-bold">Network Reach</p>
                <p class="text-xs font-bold text-dark">100+ Global Analysts</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Heading, Story & Content -->
        <div class="col-12 md:col-7 lg:col-8">
          <div class="mb-4">
            <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full mb-3">
              About LogicCompare
            </span>
            <h1 set:html={markdownify(title)} class="h2 text-2xl sm:text-3xl font-extrabold text-dark leading-tight" />
          </div>

          <div class="content text-dark/90 leading-relaxed space-y-4 mb-8">
            <Content />
          </div>

          <div class="pt-2">
            <a
              href="/contact"
              class="btn btn-primary text-white font-semibold px-6 py-3 rounded-xl shadow hover:shadow-lg hover:-translate-y-0.5 transition duration-300 inline-block"
            >
              Get In Touch →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Pillars 3-Column Section -->
  <section class="section pt-4 pb-16 bg-light/50 border-t border-border/60">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="h3 font-bold text-dark mb-2">{what_i_do.title}</h2>
        <div class="w-12 h-1 bg-primary mx-auto rounded-full"></div>
      </div>
      <div class="row justify-center gy-6 gx-6">
        {
          what_i_do.items.map((item: any, idx: number) => {
            const IconComponent = pillarIcons[idx % pillarIcons.length] || FiCheckCircle;
            return (
              <div class="col-12 md:col-4">
                <div class="h-full bg-white border border-border/80 rounded-2xl p-6 sm:p-8 shadow-xs hover:shadow-md hover:-translate-y-1 transition duration-300 flex flex-col items-center text-center">
                  <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-2xl mb-5 shadow-xs">
                    <IconComponent />
                  </div>
                  <h3 class="h4 text-lg font-bold text-dark mb-3">{item.title}</h3>
                  <p class="text-text text-sm leading-relaxed">{item.description}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

