---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { BiCategoryAlt } from "react-icons/bi";

// Pull categories from posts
const allPosts = await getSinglePage("posts");

const postCategories = allPosts.flatMap((post) => {
  const cats = post.data.categories || [];
  // Enforce Tech -> Technology unification
  return cats.map((c: string) => (c.trim().toLowerCase() === "tech" ? "Technology" : c.trim()));
});

// Compute count per category based strictly on published articles
const categoryCounts = postCategories.reduce((acc, cat) => {
  if (cat) {
    acc[cat] = (acc[cat] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

// 4 Core Master Categories
const CORE_CATEGORIES = ["Technology", "Finance", "Gaming", "Sports"];
CORE_CATEGORIES.forEach((cat) => {
  if (categoryCounts[cat] === undefined) {
    categoryCounts[cat] = 0;
  }
});

// Sort categories alphabetically
const sortedCategories = Object.keys(categoryCounts).filter(c => c.toLowerCase() !== "tech").sort();
---

<Base title="Categories | LogicCompare" description="Explore authoritative benchmark and comparative breakdowns across Technology, Finance, Gaming, and Sports.">
  <section class="section py-14">
    <div class="container text-center">
      <!-- Title & Underline -->
      <div class="text-center mb-12">
        <h1 class="h2 font-bold text-dark mb-1">Categories</h1>
        <div class="w-12 h-1 bg-primary mx-auto rounded-full"></div>
      </div>

      <!-- Dynamic Category Cloud -->
      <div class="max-w-4xl mx-auto flex flex-wrap justify-center items-center gap-3">
        {
          sortedCategories.map((category) => (
            <a
              href={`/categories/${slugify(category)}`}
              class="inline-flex items-center gap-2 bg-light/90 hover:bg-primary text-dark hover:text-white px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm transition duration-300 border border-border/80 shadow-xs hover:shadow hover:-translate-y-0.5 group"
            >
              <BiCategoryAlt className="text-primary group-hover:text-white transition h-4 w-4" />
              <span>{humanize(category)}</span>
              {categoryCounts[category] > 0 && (
                <span class="text-[11px] opacity-70 group-hover:opacity-100 font-normal">
                  ({categoryCounts[category]})
                </span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
