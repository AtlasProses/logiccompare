---
import Posts from "@/components/Posts.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPosts = sortedPosts.length;
const initialBatch = 21;
---

<Base>
  <h1 class="sr-only">LogicCompare: Comparative Intelligence on Technology, Finance, AI, and Systems</h1>
  <section class="section">
    <div class="container">
      <Posts posts={sortedPosts} initialLimit={initialBatch} className="mb-8" />

      <!-- Dynamic Load More Section (Plate & Prose Style) -->
      <div class="text-center my-10" id="loadMoreContainer">
        <p class="text-sm text-text/70 mb-3 font-medium" id="loadMoreCounter">
          Showing <span id="visiblePostCount">{Math.min(initialBatch, totalPosts)}</span> of {totalPosts} posts
        </p>
        {
          totalPosts > initialBatch && (
            <button
              id="loadMoreBtn"
              type="button"
              class="btn btn-primary px-8 py-3 rounded-xl font-bold inline-flex items-center gap-2 shadow-md hover:scale-105 active:scale-95 transition cursor-pointer"
            >
              <span>Load More</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </button>
          )
        }
      </div>
    </div>
  </section>

  <script is:inline>
    function setupLoadMore() {
      const btn = document.getElementById("loadMoreBtn");
      const counter = document.getElementById("visiblePostCount");
      if (!btn || !counter) return;

      btn.onclick = () => {
        const hiddenItems = Array.from(
          document.querySelectorAll(".load-more-item.hidden")
        );
        const batchSize = 10;
        const toShow = hiddenItems.slice(0, batchSize);

        toShow.forEach((item) => {
          item.classList.remove("hidden");
          setTimeout(() => {
            item.classList.remove("opacity-0");
          }, 30);
        });

        const totalItems = document.querySelectorAll(".post-grid-item").length;
        const remainingHidden = document.querySelectorAll(
          ".load-more-item.hidden"
        ).length;
        const currentVisible = totalItems - remainingHidden;

        counter.textContent = String(currentVisible);

        if (remainingHidden === 0) {
          btn.style.display = "none";
          const container = document.getElementById("loadMoreContainer");
          if (container && !document.getElementById("allLoadedText")) {
            const endText = document.createElement("p");
            endText.id = "allLoadedText";
            endText.className = "text-xs text-text/50 mt-2 font-medium";
            endText.textContent = "All posts loaded";
            container.appendChild(endText);
          }
        }
      };
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupLoadMore);
    } else {
      setupLoadMore();
    }
    document.addEventListener("astro:page-load", setupLoadMore);
  </script>
</Base>


