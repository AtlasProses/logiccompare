---
import config from "@/config/config.json";
const { src } = Astro.props;
const {
  logo,
  logo_text,
  title,
} = config.site;
---

<a href="/" class="navbar-brand flex items-center py-1">
  {
    src || logo ? (
      <img
        src={src ? src : logo}
        alt={title}
        class="h-10 sm:h-11 w-auto object-contain transition duration-200 hover:opacity-95"
        loading="eager"
      />
    ) : logo_text ? (
      <span class="text-xl font-bold text-dark">{logo_text}</span>
    ) : (
      <span class="text-xl font-bold text-dark">{title}</span>
    )
  }
</a>

