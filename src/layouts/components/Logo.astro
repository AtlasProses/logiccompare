---
import config from "@/config/config.json";
const { src } = Astro.props;
const {
  logo,
  logo_text,
  title,
} = config.site;
---

<a href="/" class="navbar-brand flex items-center py-0.5">
  {
    src || logo ? (
      <img
        src={src ? src : logo}
        alt={title}
        class="h-14 sm:h-16 md:h-20 lg:h-24 w-auto max-w-[220px] sm:max-w-[260px] md:max-w-[300px] lg:max-w-[360px] object-contain transition-all duration-200 hover:opacity-95"
        loading="eager"
      />
    ) : logo_text ? (
      <span class="text-xl font-bold text-dark">{logo_text}</span>
    ) : (
      <span class="text-xl font-bold text-dark">{title}</span>
    )
  }
</a>


