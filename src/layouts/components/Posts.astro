---
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  fluid?: boolean;
  initialLimit?: number;
};

const authors = await getSinglePage("authors");
const { className, posts, fluid = true, initialLimit } = Astro.props;
---

<div class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""}`}>
  {
    posts.map((post, i: number) => {
      const isFirstFeatured = i === 0 && fluid !== false;
      const isHidden = initialLimit !== undefined && i >= initialLimit;
      const postAuthor = authors.find((author) =>
        post.data.authors
          .map((a: string) => slugify(a))
          .includes(slugify(author.data.title))
      );

      if (isFirstFeatured) {
        return (
          <div class="col-12 mb-6 post-grid-item">

            <div class="flex flex-col md:flex-row gap-6 lg:gap-8 items-stretch rounded-2xl p-4 sm:p-6 bg-light/30 border border-border/50 hover:border-primary/40 transition duration-300 group">
              <!-- Left: Image -->
              <div class="w-full md:w-1/2 flex-shrink-0">
                {post.data.image && (
                  <a
                    href={`/blog/${post.id}`}
                    class="rounded-xl block hover:text-primary overflow-hidden h-full"
                  >
                    <Image
                      class="group-hover:scale-[1.03] transition duration-300 w-full h-full object-cover rounded-xl aspect-[16/10] md:aspect-auto min-h-[240px] max-h-[360px]"
                      src={post.data.image}
                      alt={post.data.title}
                      width={600}
                      height={380}
                      loading="eager"
                    />
                  </a>
                )}
              </div>

              <!-- Right: Content -->
              <div class="w-full md:w-1/2 flex flex-col justify-between py-1">
                <div>
                  <ul class="mb-3 flex flex-wrap items-center text-text text-sm">
                    {postAuthor && (
                      <li class="mr-4">
                        <a
                          href={`/authors/${slugify(postAuthor.data.title)}`}
                          class="flex items-center hover:text-primary font-medium"
                        >
                          {postAuthor.data.image && (
                            <Image
                              src={postAuthor.data.image}
                              alt={postAuthor.data.title}
                              height={50}
                              width={50}
                              class="mr-2 h-6 w-6 rounded-full object-cover"
                            />
                          )}
                          <span>{postAuthor.data.title}</span>
                        </a>
                      </li>
                    )}
                    <li class="mr-4 flex items-center flex-wrap font-medium">
                      <BiCalendarEdit className="mr-1 h-4 w-4 text-gray-600" />
                      {dateFormat(post.data.date!)}
                    </li>
                    <li class="mr-4 flex items-center flex-wrap">
                      <BiCategoryAlt className="mr-1 h-[16px] w-[16px] text-gray-600" />
                      <ul>
                        {post.data.categories.map((category: string, catIdx: number) => (
                          <li class="inline-block">
                            <a
                              href={`/categories/${slugify(category)}`}
                              class="mr-2 hover:text-primary font-medium"
                            >
                              {humanize(category)}
                              {catIdx !== post.data.categories.length - 1 && ","}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  </ul>

                  <h2 class="mb-3 text-2xl lg:text-3xl font-bold leading-snug">
                    <a
                      href={`/blog/${post.id}`}
                      class="block hover:text-primary transition duration-300"
                    >
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="text-text line-clamp-3 lg:line-clamp-4 text-sm sm:text-base leading-relaxed mb-4">
                    {plainify(post.body ?? "")}
                  </p>
                </div>

                <div>
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center font-semibold text-primary hover:underline text-sm"
                  >
                    Read Full Story &rarr;
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      }

      return (
        <div
          class={`col-12 sm:col-6 post-grid-item ${
            isHidden ? "hidden opacity-0 load-more-item transition-all duration-500" : ""
          }`}
        >
          <div class="h-full flex flex-col justify-between">

            <div>
              {post.data.image && (
                <a
                  href={`/blog/${post.id}`}
                  class="rounded-lg block hover:text-primary overflow-hidden group"
                >
                  <Image
                    class="group-hover:scale-[1.03] transition duration-300 w-full object-cover aspect-[445/230]"
                    src={post.data.image}
                    alt={post.data.title}
                    width={445}
                    height={230}
                    loading="lazy"
                  />
                </a>
              )}
              <ul class="mt-6 mb-4 flex flex-wrap items-center text-text text-sm">
                {postAuthor && (
                  <li class="mr-4">
                    <a
                      href={`/authors/${slugify(postAuthor.data.title)}`}
                      class="flex items-center hover:text-primary font-medium"
                    >
                      {postAuthor.data.image && (
                        <Image
                          src={postAuthor.data.image}
                          alt={postAuthor.data.title}
                          height={50}
                          width={50}
                          class="mr-2 h-6 w-6 rounded-full object-cover"
                        />
                      )}
                      <span>{postAuthor.data.title}</span>
                    </a>
                  </li>
                )}
                <li class="mr-4 flex items-center flex-wrap font-medium">
                  <BiCalendarEdit className="mr-1 h-4 w-4 text-gray-600" />
                  {dateFormat(post.data.date!)}
                </li>
                <li class="mr-4 flex items-center flex-wrap">
                  <BiCategoryAlt className="mr-1 h-[16px] w-[16px] text-gray-600" />
                  <ul>
                    {post.data.categories.map((category: string, catIdx: number) => (
                      <li class="inline-block">
                        <a
                          href={`/categories/${slugify(category)}`}
                          class="mr-2 hover:text-primary font-medium"
                        >
                          {humanize(category)}
                          {catIdx !== post.data.categories.length - 1 && ","}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              </ul>

              <h3 class="mb-4 text-xl font-bold">
                <a
                  href={`/blog/${post.id}`}
                  class="block hover:text-primary transition duration-300"
                >
                  {post.data.title}
                </a>
              </h3>
            </div>

            <p class="text-text line-clamp-2 mt-auto text-sm leading-relaxed">
              {plainify(post.body ?? "")}
            </p>
          </div>
        </div>
      );
    })
  }
</div>

