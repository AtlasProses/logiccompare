---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";
import { Show, SignInButton } from "@clerk/astro/components";

const allAuthors = await getSinglePage("authors");

const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } =
  post.data;
---

<section class="section">
  <div class="container">
    <article class="row justify-center">
      <div class="md:col-10 text-center">
        <h1 set:html={markdownify(title)} class="h2" />
        <ul class="mt-4 flex flex-wrap items-center justify-center text-text">
          <li class="mx-3">
            {
              allAuthors
                .filter((author) =>
                  authors
                    .map((author: string) => slugify(author))
                    .includes(slugify(author.data.title))
                )
                .map((author) => (
                  <a
                    href={`/authors/${slugify(author.id)}`}
                    class="flex items-center hover:text-primary font-medium"
                  >
                    {author.data.image && (
                      <Image
                        src={author.data.image}
                        alt={author.data.title}
                        height={50}
                        width={50}
                        class="mr-2 h-6 w-6 rounded-full"
                      />
                    )}
                    <span>{author.data.title}</span>
                  </a>
                ))
            }
          </li>
          <li class="mx-3 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(date)}
          </li>
          <li class="mx-3 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {
                categories.map((category: string, i: number) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}`}
                      class="mr-2 hover:text-primary font-medium"
                    >
                      {humanize(category)}
                      {i !== post.data.categories.length - 1 && ","}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </div>

      <div class="col-12 mt-8 mb-2">
        {
          image && (
            <Image
              src={image}
              height={500}
              width={1000}
              alt={title}
              class="rounded-lg"
            />
          )
        }
      </div>

      <div class="md:col-10">
        <div class="content mb-16 text-left">
          <Content />
        </div>
        <div class="flex flex-wrap items-center justify-between border-b border-border pb-6 mb-10">
          <ul class="mr-4 mb-4 space-x-2">
            {
              tags.map((tag: string) => (
                <li class="inline-block">
                  <a
                    href={`/tags/${slugify(tag)}`}
                    class="block rounded-lg bg-light px-3 py-1.5 font-semibold text-dark text-xs hover:text-primary transition duration-300 border border-border"
                  >
                    #{humanize(tag)}
                  </a>
                </li>
              ))
            }
          </ul>
          <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>

        <!-- Rate this article & Show some love Box -->
        <div class="bg-light/60 border border-border rounded-2xl p-6 sm:p-8 mb-12 shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
            <!-- Rate This Article -->
            <div class="sm:border-r sm:border-border sm:pr-6 text-center sm:text-left">
              <h4 class="font-bold text-dark text-base mb-2">Rate this article</h4>
              <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
                <div class="flex text-amber-400 text-xl cursor-pointer" id="star-rating">
                  <span class="hover:scale-125 transition">★</span>
                  <span class="hover:scale-125 transition">★</span>
                  <span class="hover:scale-125 transition">★</span>
                  <span class="hover:scale-125 transition">★</span>
                  <span class="hover:scale-125 transition">★</span>
                </div>
                <span class="font-bold text-dark text-lg ml-1" id="rating-score">4.8</span>
              </div>
              <p class="text-xs text-text">9 people rated this article</p>
            </div>

            <!-- Show Some Love (Like Counter) -->
            <div class="text-center sm:pl-6 flex flex-col items-center justify-center">
              <h4 class="font-bold text-dark text-base mb-2">Show some love</h4>
              <button
                id="like-btn"
                class="group flex flex-col items-center justify-center p-3 rounded-full hover:bg-white transition duration-300 active:scale-95"
                title="Like this post"
              >
                <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-red-500 text-2xl group-hover:scale-110 transition shadow-inner">
                  ♥
                </div>
                <span class="text-xs font-bold text-dark mt-2" id="like-count">8 Likes</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Community Comments Box -->
        <div class="bg-white border border-border rounded-2xl p-6 sm:p-8 mb-16 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-4 mb-6">
            <h3 class="h4 text-xl font-bold text-dark flex items-center gap-2">
              Community Comments
              <span class="bg-primary/10 text-primary text-xs font-bold px-2.5 py-0.5 rounded-full">3</span>
            </h3>
          </div>

          <!-- Join the Conversation Banner -->
          <div class="bg-light/80 border border-border rounded-xl p-5 mb-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <h5 class="font-bold text-dark text-sm mb-1">Join the conversation</h5>
              <p class="text-xs text-text">Sign in to share your thoughts and join the verified community.</p>
            </div>
            
            <Show when="signed-out">
              <SignInButton mode="modal">
                <button class="btn btn-sm btn-primary text-xs px-4 py-2 rounded-lg font-semibold hover:scale-105 transition shadow">
                  Sign In to Comment
                </button>
              </SignInButton>
            </Show>
            <Show when="signed-in">
              <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
                ✓ Logged In as Verified Member
              </span>
            </Show>
          </div>

          <!-- Comments List -->
          <div class="space-y-6" id="comments-list">
            <!-- Comment 1 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-light/40 transition">
              <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-sm">
                E
              </div>
              <div class="flex-grow">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-dark text-sm">Evelyn Rivera</span>
                  <span class="text-[10px] font-semibold bg-primary/10 text-primary px-2 py-0.5 rounded-full">Verified Member</span>
                  <span class="text-xs text-text/70 ml-auto">2 days ago</span>
                </div>
                <p class="text-dark/90 text-sm leading-relaxed mb-2">
                  The comparison matrix in this article is outstanding! Clarified the architectural trade-offs immediately.
                </p>
                <div class="flex items-center gap-4 text-xs font-semibold text-text">
                  <button class="hover:text-primary transition flex items-center gap-1">♥ Like (4)</button>
                  <button class="hover:text-primary transition">Reply</button>
                </div>
              </div>
            </div>

            <!-- Comment 2 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-light/40 transition">
              <div class="w-10 h-10 rounded-full bg-violet-600 text-white font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-sm">
                S
              </div>
              <div class="flex-grow">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-dark text-sm">Susan Young</span>
                  <span class="text-[10px] font-semibold bg-primary/10 text-primary px-2 py-0.5 rounded-full">Verified Member</span>
                  <span class="text-xs text-text/70 ml-auto">4 days ago</span>
                </div>
                <p class="text-dark/90 text-sm leading-relaxed mb-2">
                  Highly recommend reading this in-depth analysis. One of the best benchmark summaries I've seen this month.
                </p>
                <div class="flex items-center gap-4 text-xs font-semibold text-text">
                  <button class="hover:text-primary transition flex items-center gap-1">♥ Like (2)</button>
                  <button class="hover:text-primary transition">Reply</button>
                </div>
              </div>
            </div>

            <!-- Comment 3 -->
            <div class="flex gap-4 p-4 rounded-xl hover:bg-light/40 transition">
              <div class="w-10 h-10 rounded-full bg-cyan-600 text-white font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-sm">
                D
              </div>
              <div class="flex-grow">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-dark text-sm">Dennis Rivera</span>
                  <span class="text-[10px] font-semibold bg-primary/10 text-primary px-2 py-0.5 rounded-full">Verified Member</span>
                  <span class="text-xs text-text/70 ml-auto">1 week ago</span>
                </div>
                <p class="text-dark/90 text-sm leading-relaxed mb-2">
                  Great code blocks and technical depth. Looking forward to the next comparison topic!
                </p>
                <div class="flex items-center gap-4 text-xs font-semibold text-text">
                  <button class="hover:text-primary transition flex items-center gap-1">♥ Like (1)</button>
                  <button class="hover:text-primary transition">Reply</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- Related Posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0 pb-16">
      <div class="container">
        <h2 class="mb-8 text-center h3 font-bold text-dark">Related Posts</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}

<!-- Interactive Likes & Rating Script -->
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const likeBtn = document.getElementById("like-btn");
    const likeCount = document.getElementById("like-count");
    if (likeBtn && likeCount) {
      let likes = 8;
      let hasLiked = false;
      likeBtn.addEventListener("click", () => {
        if (!hasLiked) {
          likes++;
          hasLiked = true;
          likeCount.textContent = `${likes} Likes`;
          likeBtn.classList.add("text-red-500");
        }
      });
    }
  });
</script>

