---
import Share from "@/components/Share.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";
import { Show, SignInButton } from "@clerk/astro/components";

const allAuthors = await getSinglePage("authors");

const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await render(post);
const { title, description, authors, categories, image, date, tags } =
  post.data;
---

<section class="section">
  <div class="container">
    <article class="row justify-center">
      <div class="md:col-10 text-center">
        <h1 set:html={markdownify(title)} class="h2" />
        <ul class="mt-4 flex flex-wrap items-center justify-center text-text">
          <li class="mx-3">
            {
              allAuthors
                .filter((author) =>
                  authors
                    .map((author: string) => slugify(author))
                    .includes(slugify(author.data.title))
                )
                .map((author) => (
                  <a
                    href={`/authors/${slugify(author.id)}`}
                    class="flex items-center hover:text-primary font-medium"
                  >
                    {author.data.image && (
                      <Image
                        src={author.data.image}
                        alt={author.data.title}
                        height={50}
                        width={50}
                        class="mr-2 h-6 w-6 rounded-full"
                      />
                    )}
                    <span>{author.data.title}</span>
                  </a>
                ))
            }
          </li>
          <li class="mx-3 flex items-center flex-wrap font-medium">
            <BiCalendarEdit className="mr-1 h-5 w-5 text-gray-600" />
            {dateFormat(date)}
          </li>
          <li class="mx-3 flex items-center flex-wrap">
            <BiCategoryAlt className="mr-1 h-[18px] w-[18px] text-gray-600" />

            <ul>
              {
                categories.map((category: string, i: number) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}`}
                      class="mr-2 hover:text-primary font-medium"
                    >
                      {humanize(category)}
                      {i !== post.data.categories.length - 1 && ","}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </div>

      <div class="col-12 mt-8 mb-2">
        {
          image && (
            <Image
              src={image}
              height={500}
              width={1000}
              alt={title}
              class="rounded-lg"
            />
          )
        }
      </div>

      <div class="md:col-10">
        <div class="content mb-16 text-left">
          <Content />
        </div>
        <div class="flex flex-wrap items-center justify-between border-b border-border pb-6 mb-10">
          <ul class="mr-4 mb-4 space-x-2">
            {
              tags.map((tag: string) => (
                <li class="inline-block">
                  <a
                    href={`/tags/${slugify(tag)}`}
                    class="block rounded-lg bg-light px-3 py-1.5 font-semibold text-dark text-xs hover:text-primary transition duration-300 border border-border"
                  >
                    #{humanize(tag)}
                  </a>
                </li>
              ))
            }
          </ul>
          <Share
            className="social-share mb-4"
            title={title}
            description={description}
            slug={post.id}
          />
        </div>

        <!-- Rate this article & Show some love Box -->
        <div class="bg-light/60 border border-border rounded-2xl p-6 sm:p-8 mb-12 shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
            <!-- Rate This Article -->
            <div class="sm:border-r sm:border-border sm:pr-6 text-center sm:text-left">
              <h4 class="font-bold text-dark text-base mb-2">Rate this article</h4>
              <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
                <div class="flex text-amber-400 text-2xl cursor-pointer gap-1" id="star-rating">
                  <span data-star="1" class="star hover:scale-125 transition">★</span>
                  <span data-star="2" class="star hover:scale-125 transition">★</span>
                  <span data-star="3" class="star hover:scale-125 transition">★</span>
                  <span data-star="4" class="star hover:scale-125 transition">★</span>
                  <span data-star="5" class="star hover:scale-125 transition">★</span>
                </div>
                <span class="font-bold text-dark text-lg ml-1" id="rating-score">5.0</span>
              </div>
              <p class="text-xs text-text" id="rating-count-text">Be the first to rate this article</p>
            </div>

            <!-- Show Some Love (Like Counter) -->
            <div class="text-center sm:pl-6 flex flex-col items-center justify-center">
              <h4 class="font-bold text-dark text-base mb-2">Show some love</h4>
              <button
                id="like-btn"
                class="group flex flex-col items-center justify-center p-3 rounded-full hover:bg-white transition duration-300 active:scale-95"
                title="Like this post"
              >
                <div class="w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-red-500 text-2xl group-hover:scale-110 transition shadow-inner">
                  ♥
                </div>
                <span class="text-xs font-bold text-dark mt-2" id="like-count">0 Likes</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Community Comments Box -->
        <div class="bg-white border border-border rounded-2xl p-6 sm:p-8 mb-16 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-4 mb-6">
            <h3 class="h4 text-xl font-bold text-dark flex items-center gap-2">
              Community Comments
              <span class="bg-primary/10 text-primary text-xs font-bold px-2.5 py-0.5 rounded-full" id="comment-count-badge">0</span>
            </h3>
          </div>

          <!-- Join the Conversation / Comment Submission Box -->
          <div class="bg-light/70 border border-border rounded-xl p-5 mb-8">
            <Show when="signed-out">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div>
                  <h5 class="font-bold text-dark text-sm mb-1">Join the conversation</h5>
                  <p class="text-xs text-text">Sign in with Google, X (Twitter), or Email to share your thoughts, benchmarks, and participate in technical discussions.</p>
                </div>
                
                <SignInButton mode="modal">
                  <button class="btn btn-primary text-xs px-5 py-2.5 rounded-xl font-bold shadow hover:scale-105 transition flex-shrink-0">
                    Sign In to Comment
                  </button>
                </SignInButton>
              </div>
            </Show>

            <Show when="signed-in">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-full border border-emerald-200">
                      ✓ Verified Member
                    </span>
                    <span class="text-xs text-text">Write your comment below</span>
                  </div>
                </div>

                <div class="space-y-3">
                  <textarea
                    id="comment-input"
                    class="form-textarea w-full rounded-xl border border-border focus:border-primary focus:ring-1 focus:ring-primary text-sm p-3.5 bg-white shadow-inner"
                    rows="3"
                    placeholder="Share your perspective, data points, or questions on this comparison..."
                  ></textarea>

                  <div class="flex justify-end">
                    <button
                      id="post-comment-btn"
                      class="btn btn-primary text-xs px-5 py-2.5 rounded-xl font-bold shadow hover:scale-105 transition"
                    >
                      Post Comment
                    </button>
                  </div>
                </div>
              </div>
            </Show>
          </div>

          <!-- Comments List Container -->
          <div class="space-y-4" id="comments-list">
            <!-- Dynamic comments will render here -->
          </div>

          <!-- Empty State (Shown when no comments yet) -->
          <div id="no-comments-msg" class="text-center py-10 text-text/70 bg-light/30 rounded-xl border border-dashed border-border/80">
            <p class="font-semibold text-sm text-dark">No comments yet</p>
            <p class="text-xs mt-1">Be the first to share your insights or analysis on this topic!</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- Related Posts -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0 pb-16">
      <div class="container">
        <h2 class="mb-8 text-center h3 font-bold text-dark">Related Posts</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}

<!-- Interactive Likes, Rating & Real Comments Script -->
<script is:inline define:vars={{ postSlug: post.slug }}>
  document.addEventListener("astro:page-load", () => {
    const slugKey = postSlug || window.location.pathname;

    // 1. Interactive Likes
    const likeBtn = document.getElementById("like-btn");
    const likeCount = document.getElementById("like-count");
    if (likeBtn && likeCount) {
      const storedLikes = parseInt(localStorage.getItem(`lc_likes_${slugKey}`) || "0", 10);
      const hasLiked = localStorage.getItem(`lc_has_liked_${slugKey}`) === "true";
      
      likeCount.textContent = `${storedLikes} Likes`;
      if (hasLiked) {
        likeBtn.classList.add("text-red-500");
      }

      likeBtn.onclick = () => {
        let currentLikes = parseInt(localStorage.getItem(`lc_likes_${slugKey}`) || "0", 10);
        const alreadyLiked = localStorage.getItem(`lc_has_liked_${slugKey}`) === "true";
        if (!alreadyLiked) {
          currentLikes++;
          localStorage.setItem(`lc_likes_${slugKey}`, currentLikes.toString());
          localStorage.setItem(`lc_has_liked_${slugKey}`, "true");
          likeCount.textContent = `${currentLikes} Likes`;
          likeBtn.classList.add("text-red-500");
        }
      };
    }

    // 2. Interactive Star Rating
    const starContainer = document.getElementById("star-rating");
    const ratingScore = document.getElementById("rating-score");
    const ratingCountText = document.getElementById("rating-count-text");
    if (starContainer && ratingScore && ratingCountText) {
      const storedRating = localStorage.getItem(`lc_rating_${slugKey}`) || "5.0";
      const storedRatingCount = parseInt(localStorage.getItem(`lc_rating_count_${slugKey}`) || "0", 10);

      ratingScore.textContent = storedRating;
      if (storedRatingCount > 0) {
        ratingCountText.textContent = `${storedRatingCount} ${storedRatingCount === 1 ? 'person' : 'people'} rated this article`;
      }

      const stars = starContainer.querySelectorAll(".star");
      stars.forEach((star) => {
        star.onclick = () => {
          const val = parseInt(star.getAttribute("data-star") || "5", 10);
          let count = parseInt(localStorage.getItem(`lc_rating_count_${slugKey}`) || "0", 10) + 1;
          localStorage.setItem(`lc_rating_${slugKey}`, val.toFixed(1));
          localStorage.setItem(`lc_rating_count_${slugKey}`, count.toString());
          
          ratingScore.textContent = val.toFixed(1);
          ratingCountText.textContent = `${count} ${count === 1 ? 'person' : 'people'} rated this article`;
        };
      });
    }

    // 3. Dynamic Real Comments
    const commentsList = document.getElementById("comments-list");
    const noCommentsMsg = document.getElementById("no-comments-msg");
    const commentBadge = document.getElementById("comment-count-badge");
    const commentInput = document.getElementById("comment-input");
    const postCommentBtn = document.getElementById("post-comment-btn");

    function renderComments() {
      if (!commentsList) return;
      const rawComments = localStorage.getItem(`lc_comments_${slugKey}`);
      const comments = rawComments ? JSON.parse(rawComments) : [];

      if (commentBadge) commentBadge.textContent = comments.length.toString();

      if (comments.length === 0) {
        commentsList.innerHTML = "";
        if (noCommentsMsg) noCommentsMsg.style.display = "block";
      } else {
        if (noCommentsMsg) noCommentsMsg.style.display = "none";
        commentsList.innerHTML = comments
          .map(
            (c, idx) => `
            <div class="flex gap-4 p-4 rounded-xl bg-light/30 border border-border/60 hover:bg-light/60 transition">
              <div class="w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-sm">
                ${c.author.charAt(0).toUpperCase()}
              </div>
              <div class="flex-grow">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-dark text-sm">${c.author}</span>
                  <span class="text-[10px] font-semibold bg-primary/10 text-primary px-2 py-0.5 rounded-full">Verified Analyst</span>
                  <span class="text-xs text-text/70 ml-auto">${c.time}</span>
                </div>
                <p class="text-dark/90 text-sm leading-relaxed mb-2">${c.text}</p>
                <div class="flex items-center gap-4 text-xs font-semibold text-text">
                  <button class="hover:text-primary transition flex items-center gap-1">♥ Like (${c.likes || 0})</button>
                </div>
              </div>
            </div>
          `
          )
          .join("");
      }
    }

    renderComments();

    if (postCommentBtn && commentInput) {
      postCommentBtn.onclick = () => {
        const text = commentInput.value.trim();
        if (!text) return;

        const rawComments = localStorage.getItem(`lc_comments_${slugKey}`);
        const comments = rawComments ? JSON.parse(rawComments) : [];

        // Try getting Clerk user name if available, or fallback to Verified Member
        const newComment = {
          author: "Verified Analyst",
          text: text,
          time: "Just now",
          likes: 0,
        };

        comments.unshift(newComment);
        localStorage.setItem(`lc_comments_${slugKey}`, JSON.stringify(comments));
        commentInput.value = "";
        renderComments();
      };
    }
  });
</script>


