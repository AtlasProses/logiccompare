---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  date?: Date;
  authors?: string[];
  categories?: string[];
}

// distructure frontmatters
const { title, meta_title, description, image, noindex, canonical, date, authors, categories } =
  Astro.props;

const pageUrl = `${config.site.base_url}/${Astro.url.pathname.replace(/^\//, "")}`;
const imageUrl = `${config.site.base_url}${image ? image : config.metadata.meta_image}`;
const isPost = Astro.url.pathname.includes("/blog/") || Astro.url.pathname.includes("/posts/");

// Schema.org JSON-LD Structured Data
const schemaData = isPost
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "headline": plainify(meta_title || title || config.site.title),
      "description": plainify(description || config.metadata.meta_description),
      "image": [imageUrl],
      "datePublished": date ? new Date(date).toISOString() : new Date().toISOString(),
      "dateModified": date ? new Date(date).toISOString() : new Date().toISOString(),
      "author": {
        "@type": "Person",
        "name": authors && authors.length > 0 ? authors[0] : config.metadata.meta_author,
        "url": `${config.site.base_url}/authors`
      },
      "publisher": {
        "@type": "Organization",
        "name": config.site.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${config.site.base_url}${config.site.logo}`
        }
      }
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": config.site.title,
      "url": config.site.base_url,
      "description": config.metadata.meta_description,
      "publisher": {
        "@type": "Organization",
        "name": config.site.title,
        "logo": {
          "@type": "ImageObject",
          "url": `${config.site.base_url}${config.site.logo}`
        }
      }
    };
---

<!doctype html>
<html lang="en">
  <head>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="logiccompare" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- Webmaster Verifications (Google, Bing, Yandex) -->
    {config.webmaster_verifications?.google && (
      <meta name="google-site-verification" content={config.webmaster_verifications.google} />
    )}
    {config.webmaster_verifications?.bing && (
      <meta name="msvalidate.01" content={config.webmaster_verifications.bing} />
    )}
    {config.webmaster_verifications?.yandex && (
      <meta name="yandex-verification" content={config.webmaster_verifications.yandex} />
    )}

    <!-- Google AdSense Readiness -->
    {config.google_adsense?.enable && config.google_adsense?.client_id && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${config.google_adsense.client_id}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Google Analytics (GA4) -->
    {config.google_analytics?.enable && config.google_analytics?.ga_id && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${config.google_analytics.ga_id}`}
        ></script>
        <script is:inline define:vars={{ gaId: config.google_analytics.ga_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonical || pageUrl} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={authors && authors.length > 0 ? authors[0] : config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content={isPost ? "article" : "website"} />
    <meta property="og:url" content={pageUrl} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta property="og:image" content={imageUrl} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <TwSizeIndicator />
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />

    <!-- Scroll to Top Button -->
    <button
      id="scrollToTopBtn"
      class="fixed bottom-8 right-8 bg-primary text-white p-3 rounded-full shadow-lg opacity-0 invisible transition-all duration-300 hover:bg-opacity-80 z-50 focus:outline-none cursor-pointer"
      aria-label="Scroll to top"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"
        ></path>
      </svg>
    </button>
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const btn = document.getElementById("scrollToTopBtn");
        if (!btn) return;
        const handleScroll = () => {
          if (window.scrollY > 300) {
            btn.classList.remove("opacity-0", "invisible");
            btn.classList.add("opacity-100", "visible");
          } else {
            btn.classList.add("opacity-0", "invisible");
            btn.classList.remove("opacity-100", "visible");
          }
        };
        window.addEventListener("scroll", handleScroll);
        handleScroll();
        btn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      });
    </script>

    <!-- Cookie Consent Banner -->
    <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 right-0 bg-dark text-white p-4 shadow-lg transform translate-y-full transition-transform duration-500 z-[100] flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div class="text-sm">
        <p>
          We use cookies (including third-party cookies) to provide you with the
          best possible experience and to serve personalized ads. By clicking
          "Accept", you consent to the use of all cookies. Visit our <a
            href="/privacy-policy"
            class="text-primary underline">Privacy Policy</a
          > for more information.
        </p>
      </div>
      <div class="flex gap-3 shrink-0">
        <button
          id="cookie-reject"
          class="px-4 py-2 text-sm font-medium border border-gray-400 rounded hover:bg-gray-700 transition-colors cursor-pointer"
        >
          Reject All
        </button>
        <button
          id="cookie-accept"
          class="px-4 py-2 text-sm font-medium bg-primary text-white rounded hover:bg-opacity-90 transition-colors cursor-pointer"
        >
          Accept All
        </button>
      </div>
    </div>
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const banner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("cookie-accept");
        const rejectBtn = document.getElementById("cookie-reject");
        if (!banner || !acceptBtn || !rejectBtn) return;

        if (!localStorage.getItem("cookieConsent")) {
          setTimeout(() => {
            banner.classList.remove("translate-y-full");
          }, 500);
        }

        const handleConsent = (choice) => {
          localStorage.setItem("cookieConsent", choice);
          banner.classList.add("translate-y-full");
        };

        acceptBtn.addEventListener("click", () => handleConsent("accepted"));
        rejectBtn.addEventListener("click", () => handleConsent("rejected"));
      });
    </script>
  </body>
</html>


